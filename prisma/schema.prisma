// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  apiKey    String?  @unique // API Key for authentication
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
  webhooks  Webhook[]
  notifications Notification[]
  sessionAccesses SessionAccess[]
  datafyChannelAccesses DatafyChannelAccess[]
  datafyAssignedConversations DatafyConversation[] @relation("DatafyAssignedTo")
  datafySentMessages DatafyMessage[] @relation("DatafySentBy")
  crmContactsCreated CrmContact[] @relation("CrmContactCreatedBy")
  crmContactsUpdated CrmContact[] @relation("CrmContactUpdatedBy")
  datafyCampaignsCreated DatafyCampaign[] @relation("DatafyCampaignCreatedBy")
  datafyBulletinDraftsCreated DatafyBulletinDraft[] @relation("DatafyBulletinDraftCreatedBy")
  datafyManagedTemplatesCreated DatafyManagedTemplate[] @relation("DatafyManagedTemplateCreatedBy")
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  name        String    // e.g. "Marketing WA"
  sessionId   String    @unique // The unique ID used for Baileys auth
  status      String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ZOMBIE
  qr          String?   @db.Text
  config      Json?     // Store instance specific config (e.g. "read_receipts": true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  messages    Message[]
  chats       Chat[]
  groups      Group[]
  autoReplies AutoReply[]
  stories     Story[]
  scheduledMessages ScheduledMessage[]
  webhooks    Webhook[]
  botConfig   BotConfig?
  sessionAccesses SessionAccess[]
}

/// Inbox conversation mirrored from WhatsApp (Baileys chats.* / history)
model Chat {
  id              String   @id @default(cuid())
  sessionId       String
  jid             String
  name            String?
  unreadCount     Int      @default(0)
  archived        Boolean  @default(false)
  pinned          Boolean  @default(false)
  muted           Boolean  @default(false)
  conversationTs  DateTime?
  lastMessageAt   DateTime?
  lastPreview     String?  @db.Text
  lastMsgType     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
  @@index([sessionId, lastMessageAt])
  @@index([sessionId, conversationTs])
}

model Contact {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // remoteJid (123456@s.whatsapp.net)
  lid         String?  // LID JID
  name        String?
  notify      String?  // Pushname
  verifiedName String? // Business Name
  remoteJidAlt String? // Alternate JID (e.g. Phone if JID is LID)
  profilePic  String?  @db.Text
  data        Json?    // Detailed contact data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([sessionId, jid])
}

model Message {
  id          String        @id @default(cuid())
  sessionId   String
  remoteJid   String        // Receiver or Group Jid
  senderJid   String?       // If group, who sent it. If private, same as remoteJid (incoming) or me (outgoing)
  fromMe      Boolean
  keyId       String        // WhatsApp Message Key ID
  pushName    String?
  type        MessageType   @default(TEXT)
  content     String?       @db.Text // Text content or Caption
  mediaUrl    String?       @db.Text // Path to file if media
  status      MessageStatus @default(PENDING)
  timestamp   DateTime      @default(now())
  
  quoteId     String?       // For replies
  
  contactId   String?
  contract    Contact?      @relation(fields: [contactId], references: [id])
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([sessionId, remoteJid])
  @@index([sessionId, remoteJid, timestamp])
}

model Group {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  subject     String?
  description String?  @db.Text
  ownerJid    String?
  participants Json?   // Stored as JSON for now: [{id: '123@s.whatsapp.net', admin: 'admin' | null}]
  creation    DateTime?
  restrict    Boolean? // Only admins can edit group info
  announce    Boolean? // Only admins can send messages
  
  metadata    Json?    // Raw full metadata dump
  
  inviteCode  String?
  
  // Community Features
  isCommunity Boolean  @default(false)
  linkedParentJid String? // JID of the community parent group if it belongs to one
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}

model AutoReply {
  id          String   @id @default(cuid())
  sessionId   String
  keyword     String
  matchType   String   // EXACT, CONTAINS, REGEX
  response    String?  @db.Text
  isMedia     Boolean  @default(false)
  mediaUrl    String?
  mediaType   String?
  triggerType String   @default("ALL") // ALL, GROUP, PRIVATE
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Story {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // User who posted the story or Broadcast JID
  content     String?  @db.Text
  mediaUrl    String?  @db.Text
  type        String   // IMAGE, VIDEO, TEXT
  timestamp   DateTime @default(now())
  viewed      Boolean  @default(false)

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ScheduledMessage {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  content     String?  @db.Text
  mediaUrl    String?
  mediaType   String?  // image, video, document, etc.
  sendAt      DateTime
  cronExpression String? // e.g., '*/5 * * * *'
  recurrenceRule String? @db.Text // UI JSON state
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Store for Baileys MultiFileAuthState (in DB)
model AuthState {
  id        String   @id @default(cuid())
  sessionId String
  key       String   // Filename/Key (creds.json, etc)
  value     Json
  
  @@unique([sessionId, key])
}

// Webhook configuration for external event notifications
model Webhook {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String?  // Optional: specific session, null = all sessions
  name        String   // e.g. "My Server Webhook"
  url         String   // The webhook endpoint URL
  secret      String?  // Optional secret for HMAC signing
  events      Json     // Array of event types: ["message.received", "message.sent", "connection.update", etc.]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]
}

// Webhook delivery logs — tracks every webhook request attempt
model WebhookLog {
  id                 String   @id @default(cuid())
  webhookId          String
  event              String   // The event that triggered this webhook
  status             String   // SUCCESS, FAILED
  requestUrl         String   @db.Text
  requestHeaders     Json?
  requestBody        Json?
  responseStatusCode Int?
  responseBody       String?  @db.Text
  responseTimeMs     Int?
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  webhook            Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
}

enum AccessMode {
  ALL
  OWNER
  SPECIFIC
  BLACKLIST
}

model BotConfig {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  enabled       Boolean  @default(true)
  
  // Bot Command Access
  botName       String   @default("WA-AKG Bot")
  botMode       AccessMode @default(OWNER)
  botAllowedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"]
  botBlockedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"] for BLACKLIST mode

  // Auto Reply Access
  autoReplyMode AccessMode @default(ALL)
  autoReplyAllowedJids Json?
  autoReplyBlockedJids Json? // Array of JIDs for BLACKLIST mode

  enableSticker Boolean  @default(true)
  enableVideoSticker Boolean @default(true)
  maxStickerDuration Int @default(10) // in seconds
  enablePing    Boolean  @default(true)
  enableUptime  Boolean  @default(true)
  removeBgApiKey String?
  prefix        String   @default("#")
  
  // Anti-Spam / Rate Limit
  antiSpamEnabled Boolean @default(false)
  spamLimit       Int     @default(5)    // Messages allowed in window
  spamInterval    Int     @default(10)   // Seconds window
  spamDelayMin    Int     @default(1000) // MS min delay
  spamDelayMax    Int     @default(3000) // MS max delay

  // Automation & Presence
  welcomeMessage  String? @db.Text
  autoRead        Boolean @default(false)
  alwaysOnline    Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                 String   @id @default("default") // Singleton ID
  appName            String   @default("WA-AKG")
  logoUrl            String?
  faviconUrl         String?
  timezone           String   @default("Asia/Jakarta")
  enableRegistration Boolean  @default(true)
  
  updatedAt          DateTime @updatedAt
}

// Labels/Tags for organizing chats
model Label {
  id          String      @id @default(cuid())
  sessionId   String
  name        String
  color       Int         @default(0) // 0-19 for WhatsApp color codes
  colorHex    String      @default("#FF0000") // Hex representation
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chatLabels  ChatLabel[]
  
  @@unique([sessionId, name]) // Unique label name per session
  @@index([sessionId])
}

// Many-to-many relationship between chats and labels
model ChatLabel {
  id        String   @id @default(cuid())
  labelId   String
  chatJid   String   // The JID of the chat
  createdAt DateTime @default(now())
  
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  
  @@unique([labelId, chatJid]) // Prevent duplicate label assignments
  @@index([chatJid])
  @@index([labelId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, SYSTEM
  read      Boolean  @default(false)
  href      String?
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared session access — allows session owners to grant access to other users
model SessionAccess {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

// Broadcast/Blast history & logs
model BroadcastLog {
  id          String              @id @default(cuid())
  sessionId   String              // WA session ID string
  message     String              @db.Text
  total       Int
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  status      String              @default("running") // running, completed, cancelled
  delay       Int                 @default(2000)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  recipients  BroadcastRecipient[]

  @@index([sessionId])
  @@index([sessionId, startedAt])
}

model BroadcastRecipient {
  id              String       @id @default(cuid())
  broadcastLogId  String
  jid             String
  status          String       @default("pending") // pending, sent, failed
  error           String?      @db.Text
  sentAt          DateTime?

  broadcastLog    BroadcastLog @relation(fields: [broadcastLogId], references: [id], onDelete: Cascade)

  @@index([broadcastLogId])
}

// ─── Datafy API (Meta Cloud WhatsApp) — Phase 1 integration ───
// Additive only. Does not alter Baileys AuthState or sessions.

model DatafyIntegration {
  id                 String    @id @default("default")
  enabled            Boolean   @default(false)
  /// AES-GCM encrypted channel token (sk_live_...). Never returned in full to the client.
  channelTokenEnc    String?   @db.Text
  /// AES-GCM encrypted webhook secret (whsec_...). Never returned in full to the client.
  webhookSecretEnc   String?   @db.Text
  phoneNumberId      String?
  wabaId             String?
  businessId         String?
  displayPhoneNumber String?
  clienteId          String?
  webhookConfigured  Boolean   @default(false)
  lastVerifiedAt     DateTime?
  lastError          String?   @db.Text
  /// Who may use the shared official channel operationally (not credentials).
  /// ROLE_OWNER | EXPLICIT | SUPERADMIN_ONLY
  operationalAccessMode String @default("ROLE_OWNER")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Explicit grants for operational use of the shared Datafy official channel.
/// Does not store credentials. Used when operationalAccessMode = EXPLICIT.
model DatafyChannelAccess {
  id          String   @id @default(cuid())
  userId      String   @unique
  grantedById String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// Idempotency store for Datafy webhook deliveries (x-datafy-delivery-id).
model DatafyWebhookDelivery {
  id          String   @id @default(cuid())
  deliveryId  String   @unique
  field       String?
  acceptedAt  DateTime @default(now())

  @@index([acceptedAt])
}

/// Persisted outbound/inbound message status from Datafy/Meta webhooks.
model DatafyMessageStatus {
  id           String   @id @default(cuid())
  wamid        String
  status       String   // received | sent | delivered | read | failed
  recipientId  String?
  phoneNumberId String?
  timestamp    DateTime
  errorCode    Int?
  errorTitle   String?
  errorDetails String?  @db.Text
  conversationId String?
  pricingCategory String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([wamid, status, timestamp])
  @@index([wamid])
  @@index([status])
  @@index([recipientId])
}

/// Official Datafy chat conversation (shared channel — not Baileys Session).
model DatafyConversation {
  id                    String    @id @default(cuid())
  channelId             String    @default("datafy-official")
  /// Customer WhatsApp id (digits), used as `to` when sending.
  waId                  String
  contactName           String?
  /// Alternate Meta user id (BSUID), when present.
  contactUserId         String?
  phoneNumberId         String?
  /// Optional link to organization CRM contact (Phase 4).
  crmContactId          String?
  lastMessagePreview    String?   @db.Text
  lastMessageAt         DateTime?
  /// Last inbound customer message — drives the 24h service window.
  lastCustomerMessageAt DateTime?
  unreadCount           Int       @default(0)
  /// open | pending | closed
  status                String    @default("open")
  assignedToId          String?
  assignedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignedTo  User?                     @relation("DatafyAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  crmContact  CrmContact?               @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  messages    DatafyMessage[]
  assignments DatafyAssignmentHistory[]

  @@unique([channelId, waId])
  @@index([lastMessageAt])
  @@index([assignedToId])
  @@index([unreadCount])
  @@index([status])
  @@index([crmContactId])
}

/// Organization CRM contact (shared Bom Frete directory — not Baileys session Contact).
model CrmContact {
  id                String    @id @default(cuid())
  /// Reserved for future multi-tenant; single-org installs use "default".
  organizationKey   String    @default("default")
  /// Normalized WhatsApp id (digits, typically 55…).
  waId              String
  fullName          String?
  company           String?
  city              String?
  state             String?
  /// Motorista | Transportadora | Cliente | Parceiro | Prospect | Outros
  category          String?
  /// manual | import | datafy_webhook | baileys
  origin            String    @default("manual")
  notes             String?   @db.Text
  active            Boolean   @default(true)
  /// unknown | granted | denied | opted_out
  consentStatus     String    @default("unknown")
  consentSource     String?
  consentAt         DateTime?
  optedOutAt        DateTime?
  lastInteractionAt DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy     User?                @relation("CrmContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                @relation("CrmContactUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tags          CrmContactTag[]
  conversations DatafyConversation[]

  @@unique([organizationKey, waId])
  @@index([fullName])
  @@index([company])
  @@index([city])
  @@index([state])
  @@index([category])
  @@index([origin])
  @@index([active])
  @@index([consentStatus])
  @@index([lastInteractionAt])
}

model CrmTag {
  id              String   @id @default(cuid())
  organizationKey String   @default("default")
  name            String
  colorHex        String   @default("#64748b")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts CrmContactTag[]

  @@unique([organizationKey, name])
  @@index([organizationKey])
}

model CrmContactTag {
  id        String   @id @default(cuid())
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     CrmTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([tagId])
  @@index([contactId])
}

model DatafyMessage {
  id                String    @id @default(cuid())
  conversationId    String
  /// Provider message id (wamid). Unique when present.
  wamid             String?   @unique
  /// Client-generated idempotency key for outbound sends.
  clientMessageId   String?   @unique
  /// inbound | outbound
  direction         String
  /// text | image | audio | video | document | sticker | location | template | interactive | reaction | unknown
  type              String
  body              String?   @db.Text
  mediaId           String?
  mediaUrl          String?   @db.Text
  mediaMimeType     String?
  mediaFilename     String?
  mediaSize         Int?
  caption           String?   @db.Text
  /// pending | accepted | sent | delivered | read | failed
  status            String    @default("pending")
  errorCode         Int?
  errorMessage      String?   @db.Text
  sentByUserId      String?
  providerTimestamp DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversation DatafyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?              @relation("DatafySentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([status])
  @@index([direction])
}

model DatafyAssignmentHistory {
  id             String   @id @default(cuid())
  conversationId String
  fromUserId     String?
  toUserId       String?
  /// claim | transfer | release
  action         String
  createdById    String?
  note           String?
  createdAt      DateTime @default(now())

  conversation DatafyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Official Datafy mass campaign (separate from Baileys BroadcastLog).
model DatafyCampaign {
  id                 String    @id @default(cuid())
  organizationKey    String    @default("default")
  channelId          String    @default("datafy-official")
  name               String
  description        String?   @db.Text
  /// marketing | utility | authentication | transactional | other
  purpose            String    @default("marketing")
  /// draft | scheduled | preparing | running | paused | completed | completed_with_errors | cancelled | failed
  status             String    @default("draft")
  templateName       String?
  templateLanguage   String?
  templateCategory   String?
  templateComponents Json?
  /// APPROVED | PENDING | REJECTED | PAUSED | DISABLED
  templateApprovalStatus String?
  /// existing_template | custom_submitted
  contentSource      String    @default("existing_template")
  /// User-authored body text (campaign copy / template body source).
  messageBody        String?   @db.Text
  /// message | bulletin
  contentKind        String    @default("message")
  /// Ordered bulletin/message parts (CampaignMessagePart[]). Null = legacy single body.
  messageParts       Json?
  /// Bulletin analysis meta: { title, loadCount, partCount, warnings }
  bulletinMeta       Json?
  /// Optional HEADER IMAGE — public URL used at send time (link).
  headerImageUrl     String?   @db.Text
  /// Meta header_handle from Datafy /uploads (template creation).
  headerImageHandle  String?
  /// Variable mapping: { "body": ["{{fullName}}", "{{company}}"], "header": [...] }
  variableMapping    Json?
  segmentFilter      Json?
  timezone           String    @default("America/Sao_Paulo")
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  pausedAt           DateTime?
  cancelledAt        DateTime?
  /// Milliseconds between send-attempt starts (3s–60s; stored as ms).
  delayMs            Int       @default(10000)
  batchSize          Int       @default(10)
  /// When true, queue advances without calling Datafy send API.
  dryRun             Boolean   @default(false)
  requireConsent     Boolean   @default(true)
  totalSelected      Int       @default(0)
  totalEligible      Int       @default(0)
  totalExcluded      Int       @default(0)
  totalQueued        Int       @default(0)
  totalSent          Int       @default(0)
  totalAccepted      Int       @default(0)
  totalDelivered     Int       @default(0)
  totalRead          Int       @default(0)
  totalFailed        Int       @default(0)
  totalSkipped       Int       @default(0)
  totalCancelled     Int       @default(0)
  lastError          String?   @db.Text
  /// Earliest instant the next send attempt may start (persistent pacing).
  nextSendEligibleAt DateTime?
  /// Worker lock for single-runner safety.
  lockedAt           DateTime?
  lockedBy           String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy  User?                     @relation("DatafyCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients DatafyCampaignRecipient[]
  events     DatafyCampaignEvent[]
  bulletinDrafts DatafyBulletinDraft[]

  @@index([organizationKey, status])
  @@index([channelId, status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([status, lockedAt])
}

model DatafyCampaignRecipient {
  id              String    @id @default(cuid())
  campaignId      String
  crmContactId    String?
  waId            String
  fullName        String?
  company         String?
  /// pending | skipped | queued | sending | accepted | sent | delivered | read | failed | cancelled | unknown_after_send
  status          String    @default("pending")
  skipReason      String?
  attemptCount    Int       @default(0)
  maxAttempts     Int       @default(3)
  clientMessageId String?   @unique
  wamid           String?
  datafyMessageId String?
  conversationId  String?
  /// Multi-part bulletin progress: { nextPartIndex, parts: [{index,status,clientMessageId,wamid,...}] }
  partStatuses    Json?
  lastError       String?   @db.Text
  errorCode       Int?
  nextAttemptAt   DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign DatafyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, waId])
  @@index([campaignId, status])
  @@index([wamid])
  @@index([crmContactId])
  @@index([status, nextAttemptAt])
}

model DatafyCampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  /// status_change | started | paused | resumed | cancelled | recipient_update | error | note
  type       String
  fromStatus String?
  toStatus   String?
  message    String?  @db.Text
  meta       Json?
  actorId    String?
  createdAt  DateTime @default(now())

  campaign DatafyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([type])
}

/// Smart freight bulletin draft (paste → analyze → review → campaign).
/// Does not store Datafy credentials. Loads live in JSON for flexibility.
model DatafyBulletinDraft {
  id              String    @id @default(cuid())
  organizationKey String    @default("default")
  /// draft | confirmed | used_in_campaign | archived
  status          String    @default("draft")
  title           String
  operationType   String?
  groupUrl        String?   @db.Text
  referenceDate   String?
  generalNotes    String?   @db.Text
  /// Original pasted text (preserved integrally)
  rawText         String    @db.Text
  /// BulletinLoad[] after human review
  loads           Json
  warnings        Json?
  loadCount       Int       @default(0)
  campaignId      String?
  confirmedAt     DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User?          @relation("DatafyBulletinDraftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  campaign  DatafyCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationKey, status])
  @@index([createdAt])
  @@index([campaignId])
}

/// Managed bulletin template library (builtins overrides + custom templates).
/// Hiding a builtin persists across deploys. Meta is never changed by local delete.
/// Synced with WABA via Datafy (local submit + Meta Manager imports).
model DatafyManagedTemplate {
  id                   String    @id @default(cuid())
  organizationKey      String    @default("default")
  /// WABA id for isolation (empty string = legacy / unknown until sync).
  wabaId               String    @default("")
  /// builtin | custom | remote
  kind                 String
  /// Library id for builtins (e.g. boletim_v3_1_carga). Null for custom/remote.
  builtinId            String?
  /// Soft-hide from local library (builtins). Survives restart/deploy.
  hidden               Boolean   @default(false)
  deletedAt            DateTime?
  technicalName        String
  displayName          String
  category             String    @default("MARKETING")
  /// Official language from Meta/Datafy — do not coerce en → pt_BR.
  language             String    @default("pt_BR")
  headerText           String?   @db.Text
  bodyText             String    @db.Text
  footerText           String?   @db.Text
  /// Full Meta components JSON when synced (HEADER/BODY/FOOTER…).
  componentsJson       Json?
  /// Ordered field keys for {{1}}..{{n}} (origem, destino, frete, …)
  fieldMappings        Json
  exampleRow           Json
  loadsPerMessage      Int       @default(1)
  description          String?
  /// local | meta_import | unknown
  origin               String    @default("unknown")
  /// Ready for Criador/compose (mapped). Remote imports start false.
  inLibrary            Boolean   @default(false)
  remoteStatus         String?
  remoteTemplateId     String?
  remoteRejectedReason String?
  lastSubmittedAt      DateTime?
  lastSyncedAt         DateTime?
  /// Last status that already generated a panel notification (dedupe).
  lastNotifiedStatus   String?
  syncError            String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdBy User? @relation("DatafyManagedTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationKey, wabaId, technicalName, language])
  @@index([organizationKey, kind, hidden])
  @@index([organizationKey, builtinId])
  @@index([organizationKey, wabaId, remoteStatus])
  @@index([remoteTemplateId])
  @@index([deletedAt])
}

/// Sync lock / reconciliation bookkeeping per WABA (concurrency + last run).
model DatafyTemplateSyncState {
  id              String    @id @default(cuid())
  organizationKey String    @default("default")
  wabaId          String
  lockedAt        DateTime?
  lockOwner       String?
  lastSyncAt      DateTime?
  lastSyncError   String?   @db.Text
  lastSyncStats   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationKey, wabaId])
  @@index([lastSyncAt])
}
